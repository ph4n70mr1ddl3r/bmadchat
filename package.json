{
    "name": "bmaderp",
    "version": "0.0.0",
    "description": "A TypeScript library providing a simple sum function for adding two numbers together",
    "type": "module",
    "private": true,
    "author": "ph4n70mr1ddl3r",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ph4n70mr1ddl3r/bmaderp.git"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "clean": "rm -rf dist && rm -rf coverage",
        "build": "tsc -p tsconfig.json",
        "lint": "eslint --ext .ts,.js src test --max-warnings=0",
        "test": "JEST_JUNIT_OUTPUT_DIR=./coverage/junit jest --coverage --reporters=default --reporters=jest-junit",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "20.19.25",
        "eslint": "8.57.1",
        "@typescript-eslint/eslint-plugin": "6.21.0",
        "@typescript-eslint/parser": "6.21.0",
        "eslint-config-prettier": "9.1.2",
        "eslint-plugin-import": "2.32.0",
        "jest": "29.7.0",
        "jest-junit": "13.2.0",
        "ts-jest": "29.4.6",
        "typescript": "5.7.3"
    }
}